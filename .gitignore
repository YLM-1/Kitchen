# This .gitignore is tailored for Unity projects.

# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# Unity memory captures
[Mm]emoryCaptures/

# Asset import and build cache
[Aa]ssets/AssetStoreTools*
[Aa]ssets/StreamingAssets/aa.meta
[Aa]ssets/StreamingAssets/aa/*

# Autogenerated Visual Studio / Rider / MonoDevelop files
ExportedObj/
.consulo/
.idea/
.vs/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity crash reports
sysinfo.txt

# Builds and exported packages
*.apk
*.aab
*.unitypackage
*.app

# Gradle cache and Android build output
.gradle/
gradle-app.setting
gradleBuild/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Local environment files
.env
.env.*
!.env.example
